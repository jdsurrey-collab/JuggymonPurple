[sub_resource type="Resource" id="Dialog_0"]
script = ExtResource("4_dialog_script")
lines = Array[String](["Welcome, dear.", "Trade your coins for fine, empty prizes next door."])

[sub_resource type="Resource" id="Dialog_1"]
script = ExtResource("4_dialog_script")
lines = Array[String](["Welcome to ROCKET GAME CORNER!", "Do you crave some coins?", "¥1000 buys you 50 coins. Shall we begin?"])

[sub_resource type="Resource" id="Dialog_2"]
script = ExtResource("4_dialog_script")
lines = Array[String](["Keep this quiet, friend.", "It's whispered this den is run by TEAM ROCKET."])

[sub_resource type="Resource" id="Dialog_3"]
script = ExtResource("4_dialog_script")
lines = Array[String](["I believe these machines all cheat differently."])

[sub_resource type="Resource" id="Dialog_4"]
script = ExtResource("4_dialog_script")
lines = Array[String](["Child, care to play?"])

[sub_resource type="Resource" id="Dialog_5"]
script = ExtResource("4_dialog_script")
lines = Array[String](["I'm having such a wretched time!"])

[sub_resource type="Resource" id="Dialog_6"]
script = ExtResource("4_dialog_script")
lines = Array[String](["You there!", "Surely you've grimmer things to do, champion in the making!", "CELADON GYM's LEADER is ERIKA! She wields grass- type #MON!", "She seems gentle, but don't be fooled by it!"])

[sub_resource type="Resource" id="Dialog_7"]
script = ExtResource("4_dialog_script")
lines = Array[String](["These games are dreadful! So easy to be consumed by them!"])

[sub_resource type="Resource" id="Dialog_8"]
script = ExtResource("4_dialog_script")
lines = Array[String](["What now? Want some coins?"])

[sub_resource type="Resource" id="Dialog_9"]
script = ExtResource("4_dialog_script")
lines = Array[String](["Hey now! You've thrown off my count! Here, take these, be gone!"])

[sub_resource type="Resource" id="Dialog_10"]
script = ExtResource("4_dialog_script")
lines = Array[String](["I'm guarding this poster! Away, or else!"])

