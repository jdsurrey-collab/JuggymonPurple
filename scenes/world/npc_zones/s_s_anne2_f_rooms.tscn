[ext_resource type="Script" path="res://scripts/resources/npc_dialog_data.gd" id="4_dialog_script"]

[sub_resource type="Resource" id="Dialog_0"]
script = ExtResource("4_dialog_script")
lines = Array[String](["Fighting the young keeps this old man youthful."])

[sub_resource type="Resource" id="Dialog_1"]
script = ExtResource("4_dialog_script")
lines = Array[String](["See what I've fished up!"])

[sub_resource type="Resource" id="Dialog_2"]
script = ExtResource("4_dialog_script")
lines = Array[String](["Which do you prize- a strong #MON, or a rare?"])

[sub_resource type="Resource" id="Dialog_3"]
script = ExtResource("4_dialog_script")
lines = Array[String](["I never saw you at the party."])

[sub_resource type="Resource" id="Dialog_4"]
script = ExtResource("4_dialog_script")
lines = Array[String](["In all my years, I've seen no #MON sleep as this one does.", "It went something like this-"])

[sub_resource type="Resource" id="Dialog_6"]
script = ExtResource("4_dialog_script")
lines = Array[String](["Ah, yes. I've seen #MON ferry the living across the water!"])

[sub_resource type="Resource" id="Dialog_7"]
script = ExtResource("4_dialog_script")
lines = Array[String](["#MON can CUT small bushes down."])

[sub_resource type="Resource" id="Dialog_9"]
script = ExtResource("4_dialog_script")
lines = Array[String](["Have you seen the SAFARI ZONE, in FUCHSIA CITY?", "So many rare #MON, caged."])

[sub_resource type="Resource" id="Dialog_10"]
script = ExtResource("4_dialog_script")
lines = Array[String](["Father and I think the SAFARI ZONE is grand."])

[sub_resource type="Resource" id="Dialog_11"]
script = ExtResource("4_dialog_script")
lines = Array[String](["The CAPTAIN looks so ill, so pale, these days."])

[sub_resource type="Resource" id="Dialog_12"]
script = ExtResource("4_dialog_script")
lines = Array[String](["Many aboard fall seasick."])

