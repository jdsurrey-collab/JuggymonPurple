[sub_resource type="Resource" id="Dialog_0"]
script = ExtResource("4_dialog_script")
lines = Array[String](["Hah!", "I am BLAINE, LEADER of these burnt-out ruins.", "My #MON turn flesh to ash. So it has always", "been. Bring your BURN HEALs. You'll need them."])

[sub_resource type="Resource" id="Dialog_1"]
script = ExtResource("4_dialog_script")
lines = Array[String](["Do you know how hot #MON fire breath can get?"])

[sub_resource type="Resource" id="Dialog_2"]
script = ExtResource("4_dialog_script")
lines = Array[String](["I was a thief, but I became straight as a trainer!"])

[sub_resource type="Resource" id="Dialog_3"]
script = ExtResource("4_dialog_script")
lines = Array[String](["You can't win! I have studied #MON totally!"])

[sub_resource type="Resource" id="Dialog_4"]
script = ExtResource("4_dialog_script")
lines = Array[String](["I just like using fire #MON!"])

[sub_resource type="Resource" id="Dialog_5"]
script = ExtResource("4_dialog_script")
lines = Array[String](["I know why BLAINE became a trainer!"])

[sub_resource type="Resource" id="Dialog_6"]
script = ExtResource("4_dialog_script")
lines = Array[String](["I've been to many GYMs, but this is my favorite!"])

[sub_resource type="Resource" id="Dialog_7"]
script = ExtResource("4_dialog_script")
lines = Array[String](["Fire is weak against H2O!"])

[sub_resource type="Resource" id="Dialog_8"]
script = ExtResource("4_dialog_script")
lines = Array[String](["Yo! Champ in making!", "The hot-headed BLAINE is a fire #MON pro!", "Douse his spirits with water!", "You better take some BURN HEALs!"])

