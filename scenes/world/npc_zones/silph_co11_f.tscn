script = ExtResource("4_dialog_script")
lines = Array[String](["PRESIDENT: My thanks. You've saved us all.", "I shan't forget this moment of terror, nor your part in ending it.", "I must repay you, somehow.", "My wealth is considerable. Name your price.", "Here. Perhaps this will suffice."])

[sub_resource type="Resource" id="Dialog_1"]
script = ExtResource("4_dialog_script")
lines = Array[String](["SECRETARY: Thank you for rescuing all of us!", "We admire your courage."])

[sub_resource type="Resource" id="Dialog_2"]
script = ExtResource("4_dialog_script")
lines = Array[String](["Ah, <PLAYER>. We meet again.", "The PRESIDENT and I discuss a matter of some delicacy.", "Mind your place, child. This does not concern you.", "Or learn what true suffering is."])

[sub_resource type="Resource" id="Dialog_3"]
script = ExtResource("4_dialog_script")
lines = Array[String](["Stop right there! Don't you move!"])

[sub_resource type="Resource" id="Dialog_4"]
script = ExtResource("4_dialog_script")
lines = Array[String](["Halt! Do you have an appointment with my BOSS?"])

