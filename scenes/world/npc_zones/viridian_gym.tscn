script = ExtResource("4_dialog_script")
lines = Array[String](["So. This is where you find me.", "I meant to raise TEAM ROCKET from these ashes.", "You've hounded me twice now. No more mercy, this time.", "Face GIOVANNI once more. The last true master you shall ever meet."])

[sub_resource type="Resource" id="Dialog_1"]
script = ExtResource("4_dialog_script")
lines = Array[String](["Heh! You must be running out of steam by now!"])

[sub_resource type="Resource" id="Dialog_2"]
script = ExtResource("4_dialog_script")
lines = Array[String](["Rrrroar! I'm working myself into a rage!"])

[sub_resource type="Resource" id="Dialog_3"]
script = ExtResource("4_dialog_script")
lines = Array[String](["#MON and I, we make wonderful music together!"])

[sub_resource type="Resource" id="Dialog_4"]
script = ExtResource("4_dialog_script")
lines = Array[String](["Karate is the ultimate form of martial arts!"])

[sub_resource type="Resource" id="Dialog_5"]
script = ExtResource("4_dialog_script")
lines = Array[String](["The truly talented win with style!"])

[sub_resource type="Resource" id="Dialog_6"]
script = ExtResource("4_dialog_script")
lines = Array[String](["I'm the KARATE KING! Your fate rests with me!"])

[sub_resource type="Resource" id="Dialog_7"]
