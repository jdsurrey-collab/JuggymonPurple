[sub_resource type="Resource" id="Dialog_0"]
script = ExtResource("4_dialog_script")
lines = Array[String](["You, mon petit! We're busy. Out from underfoot!"])

[sub_resource type="Resource" id="Dialog_1"]
script = ExtResource("4_dialog_script")
lines = Array[String](["I saw a strange ball, in the trash."])

[sub_resource type="Resource" id="Dialog_2"]
script = ExtResource("4_dialog_script")
lines = Array[String](["So much work, I grow dizzy!"])

[sub_resource type="Resource" id="Dialog_3"]
script = ExtResource("4_dialog_script")
lines = Array[String](["Hum-de-hum-de- ho...", "I peel spuds every day, and every day. Hum..."])

[sub_resource type="Resource" id="Dialog_4"]
script = ExtResource("4_dialog_script")
lines = Array[String](["Did you hear of SNORLAX?", "It only eats, and sleeps."])

[sub_resource type="Resource" id="Dialog_5"]
script = ExtResource("4_dialog_script")
lines = Array[String](["Snivel...Sniff...", "Only onions for me... always onions. Snivel..."])

[sub_resource type="Resource" id="Dialog_6"]
script = ExtResource("4_dialog_script")
lines = Array[String](["Er-hem! I am indeed le CHEF.", "Tonight's main course is- Salmon du Salad!", "Les guests will grumble- fish, again. Eels au Barbecue!", "Les guests may mutiny, I fear. Prime Beef Steak!", "Have I enough fillets du beef?"])

