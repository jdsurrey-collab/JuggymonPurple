lines = Array[String](["My KOFFING was bred in ashes, in CINNABAR!", "Sweet, yet it exhales poison when it is riled!"])

[sub_resource type="Resource" id="Dialog_1"]
script = ExtResource("4_dialog_script")
lines = Array[String](["Heheh! This GYM is rife with handsome women!"])

[sub_resource type="Resource" id="Dialog_2"]
script = ExtResource("4_dialog_script")
lines = Array[String](["The GAME CORNER shames our fine city's good name!"])

[sub_resource type="Resource" id="Dialog_3"]
script = ExtResource("4_dialog_script")
lines = Array[String](["Damn! I squandered it all at the cursed slots!", "I should have traded my coins for prizes instead!"])

[sub_resource type="Resource" id="Dialog_4"]
script = ExtResource("4_dialog_script")
lines = Array[String](["Good day to you.", "I have watched you pass by, yet never had the chance to speak.", "Here is a token for your visit!"])

[sub_resource type="Resource" id="Dialog_5"]
script = ExtResource("4_dialog_script")
lines = Array[String](["This is my loyal companion, POLIWRATH!", "It rose from POLIWHIRL, by WATER STONE's grim rite!"])

[sub_resource type="Resource" id="Dialog_6"]
script = ExtResource("4_dialog_script")
lines = Array[String](["POLIWRATH: Ribi ribit!@"])

[sub_resource type="Resource" id="Dialog_7"]
