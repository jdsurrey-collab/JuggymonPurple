[sub_resource type="Resource" id="Dialog_0"]
script = ExtResource("4_dialog_script")
lines = Array[String](["<RIVAL>: Well. <PLAYER>.", "Still floundering back here, I see?", "I fare wonderfully. I've caught a host of strong and clever #MON.", "Come, let me see your poor attempt, <PLAYER>."])

[sub_resource type="Resource" id="Dialog_1"]
script = ExtResource("4_dialog_script")
lines = Array[String](["Hey! Stay out! It's not your yard! Huh? Me?", "I'm an innocent bystander! Don't you believe me?"])

[sub_resource type="Resource" id="Dialog_2"]
script = ExtResource("4_dialog_script")
lines = Array[String](["You're a trainer too? Collecting, fighting, it's a tough life."])

[sub_resource type="Resource" id="Dialog_3"]
script = ExtResource("4_dialog_script")
lines = Array[String](["That bush in front of the shop is in the way.", "There might be a way around."])

[sub_resource type="Resource" id="Dialog_4"]
script = ExtResource("4_dialog_script")
lines = Array[String](["You're making an encyclopedia on #MON? That sounds amusing."])

[sub_resource type="Resource" id="Dialog_6"]
script = ExtResource("4_dialog_script")
lines = Array[String](["OK! SLOWBRO! Use SONICBOOM! Come on, SLOWBRO pay attention!"])

[sub_resource type="Resource" id="Dialog_7"]
script = ExtResource("4_dialog_script")
lines = Array[String](["SLOWBRO took a snooze..."])

[sub_resource type="Resource" id="Dialog_8"]
script = ExtResource("4_dialog_script")
lines = Array[String](["I want a bright red BICYCLE!", "I'll keep it at home, so it won't get dirty!"])

[sub_resource type="Resource" id="Dialog_9"]
script = ExtResource("4_dialog_script")
lines = Array[String](["This is CERULEAN CAVE! Horribly strong #MON live in there!", "The #MON LEAGUE champion is the only person who is allowed in!"])

