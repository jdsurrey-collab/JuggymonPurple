[ext_resource type="Script" path="res://scripts/resources/npc_dialog_data.gd" id="4_dialog_script"]

[sub_resource type="Resource" id="Dialog_0"]
script = ExtResource("4_dialog_script")
lines = Array[String](["What do you want? Be gone!"])

[sub_resource type="Resource" id="Dialog_1"]
script = ExtResource("4_dialog_script")
lines = Array[String](["The BOSS swore he'd claim this town!"])

[sub_resource type="Resource" id="Dialog_2"]
script = ExtResource("4_dialog_script")
lines = Array[String](["Out of my path!"])

[sub_resource type="Resource" id="Dialog_3"]
script = ExtResource("4_dialog_script")
lines = Array[String](["SAFFRON belongs to TEAM ROCKET now!"])

[sub_resource type="Resource" id="Dialog_4"]
script = ExtResource("4_dialog_script")
lines = Array[String](["Wickedness makes me feel so alive!"])

[sub_resource type="Resource" id="Dialog_5"]
script = ExtResource("4_dialog_script")
lines = Array[String](["Ow! Mind where you tread!"])

[sub_resource type="Resource" id="Dialog_6"]
script = ExtResource("4_dialog_script")
lines = Array[String](["With SILPH ours, we may plunder #MON across the whole world!"])

[sub_resource type="Resource" id="Dialog_7"]
script = ExtResource("4_dialog_script")
lines = Array[String](["You felled TEAM ROCKET, all alone? Astounding!"])

[sub_resource type="Resource" id="Dialog_8"]
script = ExtResource("4_dialog_script")
lines = Array[String](["At last! TEAM ROCKET has fled! It's safe to walk these streets again!"])

[sub_resource type="Resource" id="Dialog_9"]
script = ExtResource("4_dialog_script")
lines = Array[String](["Folk ought to return to SAFFRON, now."])

[sub_resource type="Resource" id="Dialog_10"]
script = ExtResource("4_dialog_script")
lines = Array[String](["I flew here on my PIDGEOT, having read of SILPH.", "Already over? I missed all the commotion."])

[sub_resource type="Resource" id="Dialog_11"]
script = ExtResource("4_dialog_script")
lines = Array[String](["PIDGEOT: Bi bibii!@"])

[sub_resource type="Resource" id="Dialog_12"]
script = ExtResource("4_dialog_script")
lines = Array[String](["I saw the ROCKET BOSS fleeing SILPH's tower."])

[sub_resource type="Resource" id="Dialog_13"]
script = ExtResource("4_dialog_script")
lines = Array[String](["I stand as a guard.", "Suspicious sorts I turn away!"])

[sub_resource type="Resource" id="Dialog_14"]
script = ExtResource("4_dialog_script")
lines = Array[String](["... Snore...", "Ha! He's dozing at his post!"])

