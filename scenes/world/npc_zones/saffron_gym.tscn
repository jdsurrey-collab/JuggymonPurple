[sub_resource type="Resource" id="Dialog_0"]
script = ExtResource("4_dialog_script")
lines = Array[String](["I foresaw your arrival. Every detail.", "I've heard others' thoughts since childhood. It never stops.", "Never quiet. Not for a moment.", "I take no joy in battle. But if you insist I'll show you true madness."])

[sub_resource type="Resource" id="Dialog_1"]
script = ExtResource("4_dialog_script")
lines = Array[String](["SABRINA is younger than I, but I respect her!"])

[sub_resource type="Resource" id="Dialog_2"]
script = ExtResource("4_dialog_script")
lines = Array[String](["Does our unseen power scare you?"])

[sub_resource type="Resource" id="Dialog_3"]
script = ExtResource("4_dialog_script")
lines = Array[String](["#MON take on the appearance of their trainers.", "Your #MON must be tough, then!"])

[sub_resource type="Resource" id="Dialog_4"]
script = ExtResource("4_dialog_script")
lines = Array[String](["You know that power alone isn't enough!"])

[sub_resource type="Resource" id="Dialog_5"]
script = ExtResource("4_dialog_script")
lines = Array[String](["You and I, our #MON shall fight!"])

[sub_resource type="Resource" id="Dialog_6"]
script = ExtResource("4_dialog_script")
lines = Array[String](["SABRINA is young, but she's also our LEADER!", "You won't reach her easily!"])

[sub_resource type="Resource" id="Dialog_7"]
script = ExtResource("4_dialog_script")
lines = Array[String](["SAFFRON #MON GYM is famous for its psychics!", "You want to see SABRINA! I can tell!"])

