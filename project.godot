; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="PokemonPurple"
run/main_scene="res://scenes/startup/boot.tscn"
config/features=PackedStringArray("4.4", "Mobile")
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/autoloads/game_state.gd"
Dialogue="*res://scripts/autoloads/dialogue.gd"
GameData="*res://scripts/autoloads/game_data.gd"
SceneFlow="*res://scripts/autoloads/scene_flow.gd"
MapScripts="*res://scripts/autoloads/map_scripts.gd"
SaveSystem="*res://scripts/autoloads/save_system.gd"
PartyMenu="*res://scripts/autoloads/party_menu.gd"
Battle="*res://scripts/battle/battle.gd"
ChoiceMenu="*res://scripts/autoloads/choice_menu.gd"
NPCRegistry="*res://scripts/autoloads/npc_registry.gd"
BattleLauncher="*res://scripts/autoloads/battle_launcher.gd"
DevVerifyMapScenes="*res://scripts/dev/verify_all_map_scenes.gd"

[display]

window/size/viewport_width=160
window/size/viewport_height=144
window/size/window_width_override=640
window/size/window_height_override=576
window/stretch/mode="canvas_items"

[file_customization]

folder_colors={
"res://assets/": "green",
"res://data/": "pink",
"res://resources/": "orange",
"res://scenes/": "purple",
"res://scripts/": "red",
"res://tools/": "yellow"
}

